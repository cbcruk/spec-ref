{
  "name": "spec-ref-nav",
  "displayName": "SPEC Reference — 헤딩 링크",
  "version": "0.1.0",
  "description": "코드 주석의 SPEC.md#헤딩 링크를 해당 절로 점프 (표준 @see/@link 기반)",
  "categories": [
    "Other",
    "Programming Languages"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/cbcruk/spec-ref.git"
  },
  "main": "./out/extension.js",
  "scripts": {
    "build": "tsc -p .",
    "watch": "tsc -w -p .",
    "package": "pnpm build && npx --yes @vscode/vsce package --no-dependencies",
    "vscode:prepublish": "pnpm build"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.75.0",
    "typescript": "^5.4.0"
  },
  "activationEvents": [
    "onLanguage:javascript",
    "onLanguage:javascriptreact",
    "onLanguage:typescript",
    "onLanguage:typescriptreact"
  ],
  "engines": {
    "vscode": "^1.75.0"
  }
}
